{
  "name": "reza-plan-dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Reza Plan App",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "docker compose up -d --build",
  "hostRequirements": {
    "cpus": 2
  }
}
